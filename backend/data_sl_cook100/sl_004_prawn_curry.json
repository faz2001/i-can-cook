  "steps": [
    { "step": 1, "instruction": "Heat coconut oil in a pan over medium-high heat. Add sliced onion and fry for 2 minutes, then stir in the garlic, ginger, lemongrass and green chillies.", "duration_min": 3 },
    { "step": 2, "instruction": "Add the curry leaves and cinnamon stick. Fry for another 30 seconds, stirring constantly.", "duration_min": 1 },
    { "step": 3, "instruction": "Add the curry powder, ground turmeric, chilli flakes and diced tomatoes. Give everything a good stir to combine.", "duration_min": 2 },
    { "step": 4, "instruction": "Stir in the prawns and cook, stirring regularly, until just cooked through — about 3 minutes depending on prawn size.", "duration_min": 3 },
    { "step": 5, "instruction": "Pour in the coconut milk, bring to a simmer, and season with salt and pepper to taste. Serve immediately.", "duration_min": 5 }
  ],
